<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CV - Cherlize Contreras</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="cv-page">
        <header class="header">
            <div class="photo-container">
                <img src="foto.jpg" alt="Cherlize Contreras" class="profile-photo">
            </div>
            <div class="name-container">
                <div class="name-wrapper">
                    <h1>Cherlize Contreras</h1>
                    <p class="professional-title">FUTURA MÉDICO</p>
                    <div class="name-underline"></div>
                </div>
            </div>
        </header>

        <div class="content-wrapper">
            <aside class="left-column">
                <section>
                    <h3>HABILIDADES</h3>
                    <ul class="info-list">
                        <li>Buena comunicación</li>
                        <li>Deportista</li>
                        <li>Buena escuchando</li>
                        <li>Buena repostera</li>
                    </ul>
                </section>

                <section>
                    <h3>MÁS INFORMACIÓN</h3>
                    <ul class="info-list">
                        <li>Vehículo propio</li>
                        <li>Disponibilidad total</li>
                    </ul>
                </section>

                <section>
                    <h3>CONTACTO</h3>
                    <ul class="contact-list">
                        <li><i class="fas fa-phone"></i> 7122174368</li>
                        <li><i class="fas fa-envelope"></i> cheeconsan19@gmail.com</li>
                        <li><i class="fas fa-map-marker-alt"></i> Vicente Guerrero</li>
                    </ul>
                </section>

                <section>
                    <h3>IDIOMAS</h3>
                    <ul class="info-list">
                        <li><strong>Español:</strong> 100%</li>
                        <li><strong>Inglés:</strong> Básico 50%</li>
                    </ul>
                </section>
            </aside>

            <main class="right-column">
                <section>
                    <h3>SOBRE MÍ</h3>
                    <p class="description-text">
                        Me apasiona la medicina, en cualquier tipo. Soy buena escuchando a los demás, trabajo bien en equipo, apoyo a los demás, me gusta ser amable y gentil con los demás. Soy estudiante en la preparatoria.
                    </p>
                </section>

                <section>
                    <h3>EXPERIENCIA LABORAL</h3>
                    <p class="subtitle">Futura Médica</p>
                    <ul class="compact-list">
                        <li>Cursos Coursera</li>
                        <li>Cursos propedéuticos</li>
                        <li>Certificaciones Coursera</li>
                        <li>Clases privadas de inglés</li>
                    </ul>
                    <p class="note"><em>* Sin experiencia laboral pero con actitud.</em></p>
                </section>

                <section>
                    <h3>DATOS ACADÉMICOS</h3>
                    <div class="formacion-item">
                        <p><strong>Kinder:</strong> Pingos</p>
                    </div>
                    <div class="formacion-item">
                        <p><strong>Primaria, Secundaria y Preparatoria:</strong></p>
                        <p>Instituto Cultural Canadiense</p>
                        <p class="date-range">2015-2020 / 2020-2023 / 2023-2026</p>
                    </div>
                </section>
            </main>
        </div>
    </div>

</body>
</html>
      <link rel="stylesheet" href="style.css">
